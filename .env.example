# Copy this file to .env and fill in your Google account credentials.
# .env is gitignored — never commit it.

# The Google account that has access to app.greenhouse.io via SSO.
GOOGLE_EMAIL=your.email@anymindgroup.com

# Google account password OR an App Password (recommended for SSO accounts
# with passkey/2FA — https://myaccount.google.com/apppasswords).
# If your account uses a passkey, the password here is ignored — Google
# will prompt for the passkey in the browser window.
GOOGLE_PASSWORD=

# Browser display mode.
#   false (default) — headed. Required for the first run so you can complete
#                     Google's 2FA / "is this you" prompts once.
#   true             — headless. Use after the persistent Chrome profile has
#                     a valid session.
HEADLESS=false

# Where Playwright stores the persistent Chrome profile (cookies, local
# storage). Reusing this across runs means you only log in once.
CHROME_USER_DATA_DIR=./chrome-profile

# Optional: how many candidate tabs to process in parallel. Default 1.
# Higher values can trigger CloudFront's automated-traffic protection.
CONCURRENCY=1

# Optional: stop after N candidates. Useful for smoke tests.
# Leave empty for the full pull.
LIMIT=

# Note: This script deliberately uses Playwright's bundled Chromium,
# NOT your installed Google Chrome. On macOS, system Chrome + `channel="chrome"`
# would join your already-running Chrome instance and route actions through
# your personal profile. Bundled Chromium is fully isolated.
#
# Trade-off: bundled Chromium can't access passkey bindings in macOS
# Keychain. We handle passkey / 2FA via `page.pause()` — finish the step
# in your real Chrome, then press ▶ Resume in the Playwright Inspector.
USE_SYSTEM_CHROME=false
